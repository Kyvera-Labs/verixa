# ==============================================================================
# Verixa Environment Configuration Template — Local Development (Issue 390)
#
# Single source of truth matrix & documentation: docs/guides/deployment.md (Issue 389)
#
# Copy this file to .env and adjust as needed. Values here match the local
# development services provisioned by docker-compose.yml.
# ==============================================================================

# Execution mode: development | test | production
NODE_ENV=development

# TCP port and host interface the API listens on
PORT=3000
HOST=0.0.0.0

# Logging verbosity: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Database connection string matching docker-compose.yml Postgres service.
# NOTE: In production, database credentials are a secret and must be injected
# from a secrets manager (see docs/guides/deployment.md).
DATABASE_URL=postgres://verixa:verixa@localhost:5432/verixa

# Maximum pool connections and acquisition timeout
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT_SECONDS=10

# Redis connection for session revocation deny-list (Phase 05, Issue 096)
REDIS_URL=redis://localhost:6379

# HMAC secret key for access token signing.
# THIS IS A REAL SECRET: Generate your own local key with: openssl rand -base64 48
# Do not commit real production secrets to source control.
SESSION_ACCESS_TOKEN_SECRET=change-this-to-a-secure-random-secret-at-least-32-chars

# Maximum concurrent sessions per user (0 = disabled)
SESSION_MAX_CONCURRENT_SESSIONS=0

# --- Transport Security: TLS & HSTS (Issue 213) ---
# Inert in development (only sent when NODE_ENV=production)
HSTS_MAX_AGE_SECONDS=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false
ENFORCE_HTTPS=false
TRUST_PROXY=false

# --- Cross-Origin Resource Sharing (CORS) (Issue 204) ---
# Comma-separated list of allowed origins. Empty denies all cross-origin clients.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false

# --- Multi-Factor Authentication (MFA) Defaults (Issue 114) ---
# Baseline enforcement level: required | optional | disabled
MFA_ENFORCEMENT_LEVEL=optional
MFA_ALLOWED_METHODS=totp,webauthn,backup-codes

# --- OpenTelemetry OTLP Exporter & Sampling Policy (Phase 18, Issue 356) ---
# Service name reported on emitted trace resources
OTEL_SERVICE_NAME=verixa-api
# OTLP collector endpoint (leave empty to disable export locally; e.g. http://localhost:4318)
OTEL_EXPORTER_OTLP_ENDPOINT=
# Transport protocol: http/protobuf | http/json | grpc
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Optional comma-separated key=value headers sent to the collector
OTEL_EXPORTER_OTLP_HEADERS=
# Probabilistic trace sampling rate in [0, 1].
# Defaults to 1.0 (100%) in development, 0.1 (10%) in production, 0 in test.
# Error spans are always force-sampled regardless of this rate.
OTEL_TRACES_SAMPLER_RATE=1.0
# --- Rate Limiting & Abuse Prevention (Phase 15, Issue 297) ---
# Default global rate limiting parameters
RATE_LIMIT_DEFAULT_MAX=100
RATE_LIMIT_DEFAULT_WINDOW_MS=60000
# Comma-separated trusted IP addresses or CIDR blocks exempted from rate limiting
RATE_LIMIT_ALLOWLIST_IPS=127.0.0.1,::1
# Comma-separated service tokens exempted from rate limiting
RATE_LIMIT_ALLOWLIST_SERVICE_TOKENS=
# CAPTCHA trigger failure threshold for credential endpoints
CAPTCHA_FAILURE_THRESHOLD=3

# --- Test Overrides (Used by integration tests against local compose) ---
TEST_DATABASE_URL=postgres://verixa:verixa@localhost:5432/verixa_test
TEST_REDIS_URL=redis://localhost:6379
