# Copy to .env and adjust as needed. apps/api reads these via @verixa/config
# (packages/config), which validates them at startup and fails fast with a
# readable error if anything required is missing or malformed.

# development | test | production
NODE_ENV=development

# Port the API listens on.
PORT=3000

# Interface the API binds to. 0.0.0.0 to accept connections from any host
# (default, needed inside Docker); 127.0.0.1 to restrict to localhost.
HOST=0.0.0.0

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Read by @verixa/config (validated, defaults to this value) but not yet
# consumed by any repository — that starts with Issue 046. Matches the
# `verixa` database docker-compose.yml provisions for local development.
DATABASE_URL=postgres://verixa:verixa@localhost:5432/verixa

# Only used by test code (never by the running app) — points at the
# separate `verixa_test` database docker-compose.yml also provisions, so
# tests never run against the same database a developer is interactively
# using. See docs/guides/database.md.
TEST_DATABASE_URL=postgres://verixa:verixa@localhost:5432/verixa_test

# Not yet read by any application code — wired up starting Phase 05.
REDIS_URL=redis://localhost:6379
