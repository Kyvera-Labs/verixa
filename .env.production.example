# ==============================================================================
# Verixa Environment Configuration Template — Production Environment (Issue 390)
#
# Single source of truth matrix & documentation: docs/guides/deployment.md (Issue 389)
#
# Hardened production environment template.
# ALL SENSITIVE KEYS (DATABASE_URL, REDIS_URL, SESSION_ACCESS_TOKEN_SECRET)
# MUST BE INJECTED AT RUNTIME FROM A SECRETS MANAGER (Vault, AWS Secrets Manager,
# Doppler, GCP Secret Manager). NEVER COMMIT REAL SECRETS.
# ==============================================================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Production Postgres: unprivileged verixa_app role, TLS enabled
DATABASE_URL=postgres://verixa_app:prod_db_password_placeholder@prod-postgres-primary.internal:5432/verixa_prod
DATABASE_POOL_SIZE=20
DATABASE_POOL_TIMEOUT_SECONDS=10

# Production Redis Cluster / AWS ElastiCache
REDIS_URL=redis://:prod_redis_password_placeholder@prod-redis-cluster.internal:6379

# High-entropy signing secret injected from secrets manager (min 32 chars)
SESSION_ACCESS_TOKEN_SECRET=change-this-to-production-vault-secret-at-least-32-chars

SESSION_MAX_CONCURRENT_SESSIONS=5

# Full year HSTS with subdomains
HSTS_MAX_AGE_SECONDS=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false
ENFORCE_HTTPS=false
TRUST_PROXY=true

# Strict production origin allowlist
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOW_CREDENTIALS=false

# Production baseline MFA policy
MFA_ENFORCEMENT_LEVEL=required
MFA_ALLOWED_METHODS=totp,webauthn,backup-codes
