# ==============================================================================
# Verixa Environment Configuration Template — Staging Environment (Issue 390)
#
# Single source of truth matrix & documentation: docs/guides/deployment.md (Issue 389)
#
# Pre-production staging environment template. Mirrors production security
# settings while pointing to staging cluster dependencies.
# Secrets must be injected via Secrets Manager / Vault / CI secrets.
# ==============================================================================

NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Staging database: Injected via secrets manager at deploy time
DATABASE_URL=postgres://staging_app_user:staging_db_password_placeholder@staging-postgres.internal:5432/verixa_staging
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT_SECONDS=10

# Staging Redis cluster: Injected via secrets manager
REDIS_URL=redis://:staging_redis_password_placeholder@staging-redis.internal:6379

# Injected via secrets manager at deploy time (min 32 chars)
SESSION_ACCESS_TOKEN_SECRET=change-this-to-staging-vault-secret-at-least-32-chars

# Limit simultaneous active sessions in pre-production validation
SESSION_MAX_CONCURRENT_SESSIONS=5

# Transport security enforced in staging
HSTS_MAX_AGE_SECONDS=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false
ENFORCE_HTTPS=false
TRUST_PROXY=true

# Explicit staging front-end origins
CORS_ALLOWED_ORIGINS=https://staging-app.example.com
CORS_ALLOW_CREDENTIALS=false

MFA_ENFORCEMENT_LEVEL=optional
MFA_ALLOWED_METHODS=totp,webauthn,backup-codes
