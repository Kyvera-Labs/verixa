# ==============================================================================
# Verixa Environment Configuration Template — Test Environment (Issue 390)
#
# Single source of truth matrix & documentation: docs/guides/deployment.md (Issue 389)
#
# Configured for automated test suites and CI testing runs. Points to isolated
# test databases so running tests never mutates active developer state.
# ==============================================================================

NODE_ENV=test
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=silent

# Isolated test database (see infra/postgres/01-init-test-db.sh)
DATABASE_URL=postgres://verixa:verixa@localhost:5432/verixa_test
DATABASE_POOL_SIZE=5
DATABASE_POOL_TIMEOUT_SECONDS=5

# Redis revocation deny-list for test runs
REDIS_URL=redis://localhost:6379

# Deterministic dummy secret meeting the 32-character minimum length constraint
SESSION_ACCESS_TOKEN_SECRET=test-session-secret-must-be-at-least-32-chars-long
SESSION_MAX_CONCURRENT_SESSIONS=0

# Transport security inert during testing
HSTS_MAX_AGE_SECONDS=0
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false
ENFORCE_HTTPS=false
TRUST_PROXY=false

CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false

MFA_ENFORCEMENT_LEVEL=optional
MFA_ALLOWED_METHODS=totp,webauthn,backup-codes

TEST_DATABASE_URL=postgres://verixa:verixa@localhost:5432/verixa_test
TEST_REDIS_URL=redis://localhost:6379
