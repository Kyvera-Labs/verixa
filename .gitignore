# Planning documents (internal roadmap, not published until maintainers decide)

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Environment & secrets
.env
.env.*
!.env.example
!.env.*.example

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Testing
coverage/
# Stryker mutation testing: its sandbox copies and generated reports
# (docs/guides/testing/mutation-testing-spike.md).
.stryker-tmp/
**/reports/mutation/

# Prisma's generated client — platform-specific (ships a compiled query-engine
# binary for whichever OS generated it), so it must never be committed.
# Regenerate with `pnpm db:generate`. See docs/guides/database.md.
packages/database/generated/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Docker
*.pid

# Edge TLS material. The CI smoke job writes a throwaway self-signed pair
# here; production certificates are issued on the host and must never be
# committed either. The directory itself stays tracked via its .gitkeep.
infra/nginx/certs/*.pem
infra/nginx/certs/*.key
infra/nginx/certbot/*
!infra/nginx/certbot/.gitkeep

# Claude Code local state
.claude/

# Local database dumps (Issue 057). Never committed: they contain real local
# data and can be large.
backups/

# Generated SBOM (Issue 215). It is a release artifact, produced from
# pnpm-lock.yaml by `pnpm sbom:generate` and uploaded by CI — committing it
# would create a second, staler copy of the dependency graph that says nothing
# about the build it sits next to.
sbom/

# VitePress docs site (Issue 422). Both are build output: the cache is
# regenerated by every `pnpm docs:dev`/`docs:build`, and dist is the static
# site CI uploads as an artifact.
docs/.vitepress/cache/
docs/.vitepress/dist/

# CI health dashboard written by scripts/ci-dashboard/generate.ts. CI
# regenerates it from GitHub run history in notify-on-failure.yml and
# publishes it to the run summary; a local run has no history and writes
# an empty, misleading copy into the repo root.
/ci-dashboard.md
