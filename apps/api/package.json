{
  "name": "@verixa/api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./composition-root": {
      "types": "./dist/composition-root.d.ts",
      "default": "./dist/composition-root.js"
    },
    "./plugins/http-metrics": {
      "types": "./dist/plugins/http-metrics.d.ts",
      "default": "./dist/plugins/http-metrics.js"
    },
    "./shutdown": {
      "types": "./dist/shutdown.d.ts",
      "default": "./dist/shutdown.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.4",
    "@verixa/audit": "workspace:*",
    "@verixa/authorization": "workspace:*",
    "@verixa/config": "workspace:*",
    "@verixa/credentials": "workspace:*",
    "@verixa/database": "workspace:*",
    "@verixa/governance": "workspace:*",
    "@verixa/identity": "workspace:*",
    "@verixa/mfa": "workspace:*",
    "@verixa/observability": "workspace:*",
    "@verixa/notifications": "workspace:*",
    "@verixa/rate-limiting": "workspace:*",
    "@verixa/sessions": "workspace:*",
    "@verixa/shared-kernel": "workspace:*",
    "@verixa/stellar-anchor": "workspace:*",
    "@verixa/verification": "workspace:*",
    "fastify": "^5.12.8",
    "graphql": "^17.1.0",
    "ioredis": "^5.4.1",
    "mercurius": "^16.12.1",
    "openapi-response-validator": "^12.1.3",
    "zod": "^4.6.7",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "supertest": "^7.3.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
