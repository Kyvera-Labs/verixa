# syntax=docker/dockerfile:1
#
# Reusable multi-stage template for extracting any bounded context (packages/*)
# into an isolated standalone microservice, proving service-ready seams.
#
# Build context is the monorepo root:
#   docker build -f infra/docker/package.Dockerfile.template \
#     --build-arg PACKAGE_NAME=@verixa/notifications \
#     --build-arg PACKAGE_PATH=packages/notifications \
#     --build-arg PORT=3001 \
#     -t verixa-notifications .
#
# Base image: node:22-alpine
# Pinned image digest: sha256:1314fb30ec37592d5845e5a160d522c0e680972aa534549940b8d73bde88481a

ARG NODE_IMAGE=node:22-alpine

FROM ${NODE_IMAGE} AS base
RUN corepack enable
WORKDIR /repo

# ---- deps stage: install workspace dependencies ----
FROM base AS deps
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY packages packages
COPY apps apps
RUN pnpm install --frozen-lockfile

# ---- build stage: compile the package and bundle pruned production output ----
FROM deps AS build
ARG PACKAGE_NAME=@verixa/notifications
ARG PACKAGE_PATH=packages/notifications
COPY tsconfig.base.json ./

# Compile workspace dependencies and target package
RUN pnpm --filter ${PACKAGE_NAME}... run build

# Deploy standalone package output with pruned production dependencies
RUN pnpm --filter=${PACKAGE_NAME} deploy /out --prod

COPY scripts/prune-runtime-bundle.mjs scripts/
RUN node scripts/prune-runtime-bundle.mjs /out

# ---- production runtime stage: minimal unprivileged container ----
FROM ${NODE_IMAGE} AS production
ARG PORT=3001
ARG START_CMD="node dist/src/server.js"

ENV NODE_ENV=production
ENV PORT=${PORT}

RUN rm -rf /usr/local/lib/node_modules/npm \
           /usr/local/lib/node_modules/corepack \
           /usr/local/bin/npm \
           /usr/local/bin/npx \
           /usr/local/bin/corepack \
           /usr/local/include/node

RUN addgroup -S -g 10001 verixa && adduser -S -u 10001 -G verixa verixa
WORKDIR /app
COPY --from=build --chown=verixa:verixa /out .

USER verixa
EXPOSE ${PORT}

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:' + (process.env.PORT || '${PORT}') + '/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["sh", "-c", "node dist/src/server.js"]

FROM production AS runtime
