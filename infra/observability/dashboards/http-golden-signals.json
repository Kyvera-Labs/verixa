{
  "uid": "verixa-http-golden-signals",
  "title": "Verixa - HTTP Golden Signals & Health",
  "description": "HTTP golden signals (latency, traffic, errors, saturation) and service health-check status for apps/api.",
  "tags": ["verixa", "http", "golden-signals", "observability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "editable": false,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Service Health Status (up)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"verixa-api\"}",
          "legendFormat": "verixa-api"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "UP", "color": "green" }
              }
            }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Traffic - HTTP Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "x": 6, "y": 0, "w": 18, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method, route) (rate(http_requests_total{job=\"verixa-api\"}[5m]))",
          "legendFormat": "{{method}} {{route}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latency - HTTP Request Duration (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"verixa-api\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"verixa-api\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"verixa-api\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 4,
      "title": "Errors - 4xx & 5xx Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(http_requests_total{job=\"verixa-api\",status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=\"verixa-api\"}[5m])), 1e-9)",
          "legendFormat": "5xx error %"
        },
        {
          "refId": "B",
          "expr": "100 * sum(rate(http_requests_total{job=\"verixa-api\",status_code=~\"4..\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=\"verixa-api\"}[5m])), 1e-9)",
          "legendFormat": "4xx error %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "id": 5,
      "title": "Saturation - Event Loop Lag & Heap Memory",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "nodejs_eventloop_lag_p99_seconds{job=\"verixa-api\"}",
          "legendFormat": "event loop lag p99 (s)"
        },
        {
          "refId": "B",
          "expr": "nodejs_heap_size_used_bytes{job=\"verixa-api\"} / clamp_min(nodejs_heap_size_total_bytes{job=\"verixa-api\"}, 1)",
          "legendFormat": "heap utilization ratio"
        }
      ]
    }
  ]
}
