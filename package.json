{
  "name": "verixa",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source infrastructure for authentication, authorization, identity, verification, audit logging, security, and governance.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "prepare": "husky && pnpm --filter @verixa/database run db:generate",
    "db:wait": "node scripts/db-wait.mjs",
    "db:generate": "pnpm --filter @verixa/database run db:generate",
    "db:migrate": "pnpm --filter @verixa/database run db:migrate",
    "db:migrate:deploy": "pnpm --filter @verixa/database run db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @verixa/database run db:migrate:status",
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @verixa/api^... run build && pnpm --filter @verixa/api run dev",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm -r run test:coverage",
    "test:coverage:merge": "tsx infra/ci/coverage-merge.ts",
    "test:workspace:coverage": "pnpm -r --no-bail run test:coverage --coverage.thresholds.statements=0 --coverage.thresholds.branches=0 --coverage.thresholds.functions=0 --coverage.thresholds.lines=0 && pnpm run test:coverage:merge",
    "coverage:ratchet": "tsx infra/ci/coverage-ratchet.ts",
    "flaky:track": "tsx infra/ci/flaky-test-tracker.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:backup": "bash scripts/db-backup.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "db:benchmark": "pnpm --filter @verixa/identity run benchmark",
    "db:benchmark:audit": "pnpm --filter @verixa/database run benchmark:audit",
    "audit:verify-chain": "pnpm --filter @verixa/audit^... run build && pnpm --filter @verixa/audit run verify-chain",
    "check:lockfile": "node infra/ci/check-lockfile-integrity.mjs",
    "check:malware": "node infra/ci/check-malware-indicators.mjs",
    "check:env-matrix": "tsx infra/ci/check-env-matrix.ts",
    "check:migration-safety": "tsx infra/ci/check-migration-safety.ts",
    "sbom:generate": "tsx infra/ci/generate-sbom.ts",
    "release:dry-run": "npx --yes -p semantic-release@24 -p @semantic-release/commit-analyzer@13 -p @semantic-release/release-notes-generator@14 -p @semantic-release/github@11 -p conventional-changelog-conventionalcommits@8 semantic-release --dry-run --no-ci",
    "typecheck:ci": "tsc -p infra/ci/tsconfig.json --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@cyclonedx/cyclonedx-library": "^10.5.1",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ajv-formats-draft2019": "^1.6.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-security": "^4.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "yaml": "^2.9.1"
  }
}
