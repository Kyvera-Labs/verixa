{
  "name": "verixa",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source infrastructure for authentication, authorization, identity, verification, audit logging, security, and governance.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @verixa/api^... run build && pnpm --filter @verixa/api run dev",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.5.0",
    "eslint-plugin-security": "^3.0.1",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.18.1"
  }
}
