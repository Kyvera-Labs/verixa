{
  "name": "@verixa/notifications",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/src/server.d.ts",
      "default": "./dist/src/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/src/server.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@verixa/shared-kernel": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@verixa/testing-kit": "workspace:*",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
