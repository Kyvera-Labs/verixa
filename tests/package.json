{
  "name": "@verixa/integration-tests",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && vitest run --config vitest.ci.config.ts",
    "test:e2e": "vitest run --config e2e/vitest.config.ts",
    "test:load": "vitest run --config vitest.load.config.ts",
    "test:coverage": "vitest run --coverage && vitest run --config vitest.ci.config.ts --coverage --coverage.reportsDirectory=coverage/ci",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^22.10.0",
    "@types/supertest": "^7.2.1",
    "@verixa/api": "workspace:*",
    "@verixa/audit": "workspace:*",
    "@verixa/config": "workspace:*",
    "@verixa/authorization": "workspace:*",
    "@verixa/credentials": "workspace:*",
    "@verixa/database": "workspace:*",
    "@verixa/identity": "workspace:*",
    "@verixa/sessions": "workspace:*",
    "@verixa/shared-kernel": "workspace:*",
    "@verixa/testing-kit": "workspace:*",
    "@vitest/coverage-v8": "^5.1.0",
    "supertest": "^7.3.2",
    "testcontainers": "^12.2.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
